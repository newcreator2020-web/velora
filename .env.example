# VELORA — Environment template (SICUREZZA: versione QUESTO file, NON il .env reale).
#
# 1. Copia QUESTO file come ".env" nella root del progetto.
# 2. Popola i valori richiesti.
# ---------------------------------------------------------
# LOCALE (Supabase CLI) — valori default noti.
#   Possono essere lasciati tali per tutti i run `pnpm db:start` locale.
#   La password `postgres` è l'utente admin locale del DB, non un segreto.
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=velora-local
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=54322
SUPABASE_DB_PASSWORD=postgres

# ---------------------------------------------------------
# CLOUD DEV REMOTO TEMPORANEO (solo fase 1 — MAI produzione)
# Valori opzionali se vuoi usare un project remoto nel db:link.
# Queste 2 chiavi vanno recuperate da Settings → API sul dashboard.
# ---------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service_role
# SUPABASE_PROJECT_ID=xxxx
# SUPABASE_DB_PASSWORD=...

# ---------------------------------------------------------
# BILLING / STRIPE TEST MODE (FASE 8)
# Solo TEST MODE keys ufficiali. MAI valori LIVE in locale.
#
# Come ottenerli:
#  1. Dashboard Stripe → Test mode toggle ON
#  2. API keys:  https://dashboard.stripe.com/test/apikeys
#     Publishable key (pk_test_*) → NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#     Secret key      (sk_test_*) → STRIPE_SECRET_KEY
#  3. Webhook secret locale (Stripe CLI):
#     stripe listen --forward-to http://localhost:3000/api/billing/stripe/webhook
#     Copia whsec_... → STRIPE_WEBHOOK_SECRET
#  4. Product PRO price ID:
#     Crea prodotto Stripe → Price ID (price_xxx) → STRIPE_PRO_PRICE_ID
# ---------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replaceme
STRIPE_SECRET_KEY=sk_test_replaceme
STRIPE_WEBHOOK_SECRET=whsec_replaceme
STRIPE_PRO_PRICE_ID=price_xxxx_replaceme

# ---------------------------------------------------------
# EMAIL / RESEND — P0 (OBBLIGATORIO PRIMA DI QUALSIASI CLIENTE)
# Senza queste chiavi: nessuna email viene inviata (conferma, cancella,
# reminder, ricevuta caparra). Utenti finali ricevono SILENZIO TOTALE.
#
# Setup:
#  1. Crea account → https://resend.com/
#  2. Aggiungi e VERIFICA un dominio (es. agenziavelora.it)
#     (Le email da @resend.dev sono limitate, solo per test)
#  3. API Keys → Create API Key (permesso "Full access")
#     Copia re_xxx → RESEND_API_KEY
#  4. Scegli un mittente su dominio verificato:
#     ES. prenotazioni@agenziavelora.it → RESEND_FROM_EMAIL
# ---------------------------------------------------------
RESEND_API_KEY=re_replaceme_obbligatorio_min_16chars
RESEND_FROM_EMAIL=prenotazioni@tuodominioverificato.it

# ---------------------------------------------------------
# BOOKING CANCEL JWT SECRET — P0 (OBBLIGATORIO, min 32 char)
# Firma HMAC del link di cancellazione (72h) incluso in ogni email.
# SE CAMBI DOPO DEPLOY: tutti i link esistenti diventano invalidi.
#
# Genera 64 char HEX (comando Node.js monouso):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------
BOOKING_CANCEL_JWT_SECRET=inserisci_64caratteri_hex_es_a1b2c3d4e5f60000a1b2c3d4e5f60000a1b2c3d4e5f6

# ---------------------------------------------------------
# CRON API KEY — P0 (OBBLIGATORIO, min 16 char)
# Autenticazione endpoint /api/cron/booking-reminders
# (invia email reminder 24h prima dell'appuntamento).
#
# Genera 32 char HEX:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#
# Deploy:
#   Vercel  → vercel.json + Environment Variables + header x-cron-secret
#   QStash  → header x-cron-secret su ogni invocazione
#   Crontab → curl -H "x-cron-secret: TUALECHIAVE" https://tuosito/api/cron/booking-reminders
# ---------------------------------------------------------
CRON_API_KEY=inserisci_almeno_32caratteri_casuali_es_8f4c3d9a

# ---------------------------------------------------------
# APP_URL — P0 per URL pubblici nelle email
# Senza questa: i link nelle email potrebbero puntare a host sbagliato.
# Locale: http://localhost:3000   Produzione: https://app.agenziavelora.it
# ---------------------------------------------------------
APP_URL=https://app.agenziavelora.it
