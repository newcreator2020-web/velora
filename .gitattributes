# Auto-normalize line endings on checkout and commit.
* text=auto eol=lf

# Explicitly normalize sources/config/docs to LF even on Windows.
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.mts      text eol=lf
*.cts      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.css      text eol=lf
*.sql      text eol=lf
*.toml     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.env*     text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.prettierrc*   text eol=lf
eslint.config* text eol=lf

# Windows shell scripts always CRLF on checkout.
*.cmd      text eol=crlf
*.bat      text eol=crlf
*.ps1      text eol=crlf

# Binary files: never diff or normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.lock binary -text
