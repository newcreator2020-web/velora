{
  "name": "velora",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.18",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run tests/db --maxWorkers=1 --file-parallelism=false",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test:e2e:prod": "cross-env PLAYWRIGHT_USE_PRODUCTION=1 PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "playwright:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
    "db:types": "supabase gen types typescript --local --schema public > src/types/supabase.ts",
    "db:types:cloud": "supabase gen types typescript --project-id dgekfjkuvnofwdwxflms --schema public > src/types/supabase.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:link": "supabase link --project-ref dgekfjkuvnofwdwxflms --password $env:SUPABASE_DB_PASSWORD",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db seed",
    "db:test": "vitest run tests/db --maxWorkers=1 --file-parallelism=false",
    "check:db": "pnpm db:test",
    "verify": "pnpm check && pnpm db:test && pnpm build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:run src/"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint-import-resolver-typescript": "3.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "0.3.6",
    "eslint-import-resolver-typescript": "3.5.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "prettier": "^3.9.6",
    "supabase": "^2.114.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.46.0",
    "vercel": "^59.11.7",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "eslint-import-resolver-typescript": "3.5.2"
  }
}
